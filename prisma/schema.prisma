generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(cuid())
  clerkId              String          @unique
  email                String          @unique
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  tier                 String          @default("free")
  isLifetimePro        Boolean         @default(false)
  proExpiresAt         DateTime?
  isLifetimeMax        Boolean         @default(false)
  maxExpiresAt         DateTime?
  trialEndsAt          DateTime?
  // Permanent, unique per user — generated lazily on first visit to the
  // Refer a Friend page (lib/referral.ts#getOrCreateReferralCode), not at
  // account creation, so the vast majority of users who never visit that
  // page never get a wasted code.
  referralCode         String?         @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  redemptions          RedemptionLog[]
  referralsMade        Referral[]      @relation("Referrer")
}

// ── Referral program ─────────────────────────────────────────────────────────
//
// Lifecycle: PENDING (referee created an account via the link) -> SIGNED_UP
// (referee started a real Pro trial — same TrialRecord path/anti-abuse gates
// as any other trial, see app/api/stripe/checkout/route.ts) -> VALIDATED
// (the trial ran its full course and converted to a paid subscription
// without being canceled — Stripe's own trialing->active transition IS the
// anti-abuse window; a cancellation or failed charge during the trial never
// reaches 'active') -> REWARDED (both sides' rewards applied). EXPIRED means
// the referee canceled/never converted — no reward.
//
// referrerRewardApplied can be false on a REWARDED row even though
// refereeRewardApplied is true: the referee is always rewarded once
// genuinely validated, but the REFERRER's reward is capped (see
// REFERRER_REWARD_CAP in lib/referral.ts) — a referrer past the cap still
// gets credit for the referral (visible in their history) but no further
// free month, which is the documented worst-case-abuse bound from the spec.
model Referral {
  id                    String    @id @default(cuid())
  referrerUserId        String // Clerk id
  referrerEmail         String
  referrer              User      @relation("Referrer", fields: [referrerUserId], references: [clerkId])
  refereeEmail          String
  refereeUserId         String? // Clerk id — set once the referee actually creates an account
  referralCode          String
  status                String    @default("PENDING") // PENDING | SIGNED_UP | VALIDATED | REWARDED | EXPIRED
  createdAt             DateTime  @default(now())
  validatedAt           DateTime?
  rewardedAt            DateTime?
  referrerRewardApplied Boolean   @default(false)
  refereeRewardApplied  Boolean   @default(false)
  // Human-readable audit trail for support — e.g. "Extended proExpiresAt by
  // 30 days (was free tier)" or "$15.00 Stripe balance credit (was Pro)" or
  // "skipped — referrer at 5/5 reward cap".
  referrerRewardNote    String    @default("")
  refereeRewardNote     String    @default("")

  @@index([referrerUserId])
  @@index([refereeUserId])
  @@index([referralCode])
  @@index([status])
}

model PromoCode {
  id          String          @id @default(cuid())
  code        String          @unique
  type        String
  maxUses     Int
  usedCount   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  redemptions RedemptionLog[]
}

model RedemptionLog {
  id          String    @id @default(cuid())
  userId      String
  promoCodeId String
  redeemedAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [clerkId])
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
}

model Signal {
  id             String          @id @default(cuid())
  ticker         String
  companyName    String
  signalType     String
  entryZoneLow   Float
  entryZoneHigh  Float
  targetPrice    Float
  stopLoss       Float
  confidence     Float
  timeHorizon    String
  thesis         String
  aiSummary      String
  sector         String
  signalCategory String          @default("large_cap")
  // Which market session the signal's PRICING DATA came from, assigned at
  // generation time — 'regular' | 'premarket' | 'afterhours'.
  //
  // Deliberately NOT inferred from createdAt: the daily cron/signals batch
  // runs at ~7:30am ET, which falls inside the premarket clock window, but
  // it reads regular-session quotes and emits multi-day/multi-month swing
  // and long-term ideas. Tagging those 'premarket' by timestamp would be
  // flatly wrong. Only cron/extended-signals, which actually reads Schwab's
  // `extended` quote block, ever writes a non-'regular' value here — so the
  // default correctly classifies every pre-existing row.
  session        String          @default("regular")
  // Server-assigned at generation time — replaces client-side regex parsing
  // of the free-text timeHorizon string (which orphaned real signals, e.g.
  // "1-3 months" matched none of isSwingTrade/isLongTerm/isIntraday/
  // is1to3Days). One of: 'intraday' | 'days_1_3' | 'swing' | 'long_term' |
  // 'momentum'. 'momentum' is populated only by the real intraday spike
  // scanner (isMomentumSpike below) — never backfilled onto pre-existing
  // signals and never assigned by the daily/options/intraday crons.
  timeframeCategory String?
  marketCap      Float           @default(0)
  bestEntryTime  String?
  expectedMove   String?
  catalyst       String?
  // Real intraday spike detection (volume + volatility, quantitatively gated
  // — not the old client-side isMomentum(BUY && confidence>=75) mislabeling).
  // Distinct from that legacy tab so real and fake "momentum" signals never
  // mix while the old classifier still exists.
  isMomentumSpike  Boolean        @default(false)
  outcome          String?
  outcomeCheckedAt DateTime?
  outcomePrice     Float?
  // Set the first time cron/zone-check observes price inside
  // [entryZoneLow, entryZoneHigh] for an intraday/days_1_3 signal. If price
  // leaves the zone while this is still null, the signal never presented a
  // valid entry and gets retired with outcome 'LEFT_ZONE' (not a thesis
  // failure — excluded from win-rate denominators). Once set, normal
  // target/stop/expiry tracking applies regardless of later zone exits.
  enteredZoneAt    DateTime?
  isActive       Boolean         @default(true)
  autoGenerated  Boolean         @default(false)
  // TRUE for any signal created by hand in the admin panel, OR for any
  // algorithm-generated signal whose trade parameters were later edited by
  // hand there. Once true it is never set back to false.
  //
  // This flag is a TRACK-RECORD INTEGRITY control, not a UI detail: a manual
  // signal is not algorithm output, so counting it in a published win rate
  // would misrepresent what the algorithm actually produced. Every public
  // performance surface MUST filter isManual: false — see
  // lib/publicStats.ts#PUBLIC_TRACK_RECORD_FILTER, which is the single
  // source of truth for that exclusion.
  isManual       Boolean         @default(false)
  signalDate     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  trackedBy      TrackedSignal[]

  // Added — table had zero non-PK indexes despite being filtered by ticker,
  // outcome, isActive constantly (dashboard, movers, admin, every public
  // track-record query this session) and ordered by outcomeCheckedAt for
  // every strip window query. The composite covers getOutcomesSummary's
  // exact where-clause shape (timeframeCategory + outcome + isManual);
  // outcomeCheckedAt is separate since it's also used bare for ORDER BY.
  @@index([ticker])
  @@index([isActive])
  @@index([outcomeCheckedAt])
  @@index([timeframeCategory, outcome, isManual])
}

model InsiderTrade {
  id             String   @id @default(cuid())
  companyName    String
  ticker         String
  insiderName    String
  insiderTitle   String
  tradeType      String   @default("BUY")
  shares         Int
  pricePerShare  Float
  totalValue     Float
  filingDate     DateTime
  tradeDate      DateTime
  formType       String   @default("4")
  secLink        String   @default("")
  aiSignificance String   @default("MEDIUM")
  aiCommentary   String   @default("")
  createdAt      DateTime @default(now())

  @@index([ticker])
  @@index([tradeDate])
  @@index([createdAt])
}

model OptionsSignal {
  id             String   @id @default(cuid())
  ticker         String
  companyName    String
  contractType   String
  strikePrice    Float
  expirationDate String
  // Real Schwab mark price at generation time (was an AI-estimated number
  // pre-fix; field name kept for UI compatibility, semantics changed).
  premiumEstimate Float
  confidence     Float
  reasoning      String
  summary        String
  riskLevel      String   @default("Medium")
  // Real chain data (Schwab /marketdata/v1/chains) — every field below is
  // what Schwab was actually quoting for this exact contract at generation
  // time, not AI-estimated. optionSymbol is the real OCC contract symbol,
  // used to validate the signal against the chain before saving.
  optionSymbol   String   @default("")
  bid            Float    @default(0)
  ask            Float    @default(0)
  openInterest   Int      @default(0)
  impliedVolatility Float?
  delta          Float?
  gamma          Float?
  theta          Float?
  vega           Float?
  breakeven      Float?
  maxRisk        Float?
  // Cross-sectional IV percentile of the chosen contract's IV against all
  // other candidate contracts pulled for the same underlying in the same
  // chain snapshot. NOT a historical IV rank — Schwab exposes no IV history
  // endpoint, so a true 52-week IV rank isn't available; labeled honestly.
  ivPercentile   Float?
  isActive       Boolean  @default(true)
  autoGenerated  Boolean  @default(false)
  /** See Signal.isManual — same track-record-integrity semantics. */
  isManual       Boolean  @default(false)
  // Outcome tracking (added — options previously had none). null = still
  // open/pending, same null-means-pending convention as Signal.outcome.
  // Deliberately its own enum, NOT Signal's HIT_TARGET/HIT_STOP/EXPIRED:
  // options mechanics don't have a "stop loss" (max loss is always the
  // premium paid, already bounded — see maxRisk above), and expiration
  // itself is a real terminal outcome with two different shapes (worthless
  // vs. still holding intrinsic value), not a single generic EXPIRED like
  // an equity signal running out its tracking window. One of:
  // 'HIT_TARGET' (premium reached the take-profit threshold before expiry —
  //   see OPTIONS_TAKE_PROFIT_MULTIPLE in cron/options-outcomes),
  // 'EXPIRED_WORTHLESS' (expired with the underlying out-of-the-money —
  //   total loss of premium), 'EXPIRED_ITM' (expired in-the-money, retains
  //   intrinsic value — may still be a net loss vs. premium paid),
  // 'CLOSED_EARLY' (admin-recorded manual close, e.g. via the options PATCH
  //   route — never auto-set by the outcome cron).
  outcome        String?
  outcomeCheckedAt DateTime?
  // The contract's premium (mark, or computed intrinsic value at expiry)
  // at the moment outcome was determined — the options analogue of
  // Signal.outcomePrice, but premium, not underlying stock price.
  outcomePremium Float?
  // Percent change vs. premiumEstimate: (outcomePremium - premiumEstimate)
  // / premiumEstimate * 100. -100 for EXPIRED_WORTHLESS by construction.
  realizedPnL    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticker])
  @@index([isActive])
  @@index([outcome])
  @@index([expirationDate])
}

model PoliticianTrade {
  id              String   @id @default(cuid())
  externalId      String   @unique
  politicianName  String
  party           String
  chamber         String   @default("House")
  ticker          String
  companyName     String
  tradeType       String
  amountRange     String
  tradedAt        DateTime
  filedAt         DateTime
  aiCommentary    String   @default("")
  significance    String   @default("Low")
  fetchedAt       DateTime @default(now())
  // 'EQUITY' (default — every row from the existing GitHub Actions scraper)
  // or 'OPTION' (rows from cron/politician-options, the Apify Actor
  // options-only supplement). The equity scraper never writes anything but
  // the default, so no backfill was needed on existing rows.
  assetType       String   @default("EQUITY")
  // Free-text strike/expiration/contract detail (Apify's `Details` field),
  // options rows only — e.g. "Purchased 20 call options with a strike price
  // of $100 and an expiration date of 1/15/27." Null for equity rows.
  optionDetails   String?
  // TRUE when party, tradeType, or amountRange could not be resolved to a
  // real value at ingestion time (party === 'Unknown', tradeType ===
  // 'UNKNOWN', or amountRange === 'Unknown'/''). Set by every ingestion path
  // (cron/politician, cron/politician-options) and re-evaluated on every
  // upsert, so a trade can heal once the underlying data or matching logic
  // improves. NEVER show a trade with isIncomplete: true on any public
  // surface — app/politician-scanner/page.tsx filters isIncomplete: false
  // unconditionally. This is the structural fix for "never display a
  // placeholder/Unknown value": excluded, not disguised. See
  // app/admin/politician-trades/page.tsx to review excluded rows.
  isIncomplete    Boolean  @default(false)

  // Added — only externalId was indexed despite PoliticianTradesClient
  // filtering/sorting by ticker and tradedAt.
  @@index([ticker])
  @@index([tradedAt])
  @@index([politicianName])
  @@index([assetType])
  @@index([isIncomplete])
}

model NewsArticle {
  id          String   @id @default(cuid())
  finnhubId   Int      @unique
  headline    String
  summary     String
  source      String
  url         String
  imageUrl    String   @default("")
  publishedAt DateTime
  sentiment   String   @default("neutral")
  confidence  Int      @default(50)
  fetchedAt   DateTime @default(now())
}

model SectorSnapshot {
  id        String   @id @default(cuid())
  sector    String   @unique
  symbol    String
  price     Float    @default(0)
  change    Float    @default(0)
  changeAmt Float    @default(0)
  high52w   Float    @default(0)
  low52w    Float    @default(0)
  updatedAt DateTime @updatedAt
}

model MarketSummary {
  id        String   @id @default(cuid())
  singleton String   @unique @default("main")
  content   String
  updatedAt DateTime @updatedAt
}

model CalendarEntry {
  id           String   @id @default(cuid())
  symbol       String
  date         String
  hour         String   @default("")
  epsEstimate  Float?
  epsActual    Float?
  quarter      Int?
  year         Int?
  impactRating String   @default("Low")
  fetchedAt    DateTime @default(now())

  @@unique([symbol, date])
}

model SignalGenerationLog {
  id          String   @id @default(cuid())
  generatedAt DateTime @default(now())
  signalCount Int      @default(0)
  status      String   @default("success")
  error       String?
}

model TrackedSignal {
  id          String    @id @default(cuid())
  userId      String
  signalId    String
  signal      Signal    @relation(fields: [signalId], references: [id])
  ticker      String
  entryPrice  Float?
  notes       String?
  status      String    @default("watching")
  outcome     String?
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  @@unique([userId, signalId])
}

// In-app notification bell. userId is Clerk's id (matches User.clerkId),
// not a Prisma relation FK — this table is written from many places
// (crons, the Stripe webhook, /api/user/sync) that only have the Clerk id
// on hand, and a hard relation would force every one of those call sites to
// look up the User row first just to satisfy the FK. isRead/createdAt are
// composite-indexed with userId since every read path is "this user's
// unread, newest first."
// The landing page's "best result to date" showcase.
//
// NAME IS ABOUT CADENCE, NOT WINDOW: the selection pool is every closed
// signal ever recorded (highest realized gain wins); "Weekly" refers to
// cron/weekly-featured re-running each Sunday to pick up a new record.
// Kept as-is rather than renamed because a Prisma model rename is a
// drop-and-recreate, and the row here is trivially regenerated but the
// migration would need --accept-data-loss for no real benefit.
//
// Persisted rather than recomputed per render so the landing page does one
// indexed lookup instead of scanning every closed signal on each hit.
//
// weekStartDate is the Monday (ET) of the week the row was selected in, and
// is unique so a cron re-run overwrites rather than duplicates.
// realizedGainPercent is stored at selection time because it is derived from
// outcomePrice, which the outcome checker could in principle revise later.
model WeeklyFeaturedSignal {
  id                  String   @id @default(cuid())
  // Nullable: set when the cron auto-selected an actual closed Signal row;
  // null for a fully hand-entered card from the admin console. Display
  // fields below are always self-contained (never re-joined against
  // Signal at render time), so a manual entry works with no linked row.
  signalId            String?
  // Defaults exist only so `prisma db push` can add these columns onto an
  // already-populated table without failing/prompting in non-interactive
  // CI — every row written by the app code always supplies real values.
  ticker              String   @default("")
  companyName         String   @default("")
  signalType          String   @default("BUY")
  entryZoneLow        Float    @default(0)
  entryZoneHigh       Float    @default(0)
  targetPrice         Float    @default(0)
  realizedGainPercent Float
  thesis              String   @default("")
  postedAt            DateTime @default(now())
  // True when an admin hand-entered these fields via the console rather
  // than the cron computing them from real market data.
  isManualOverride    Boolean  @default(false)
  weekStartDate       DateTime @unique
  selectedAt          DateTime @default(now())

  @@index([weekStartDate])
}

// Accountability log for every admin-panel action (signal create/edit/
// delete/toggle, notification send, Schwab re-auth, manual cron triggers).
// Append-only — nothing in the app ever updates or deletes a row here.
model AdminActionLog {
  id        String   @id @default(cuid())
  adminId   String // Clerk id of the acting admin
  action    String // e.g. 'signal.create', 'notification.send', 'schwab.reauth'
  target    String   @default("") // affected entity id/ticker, when there is one
  detail    String   @default("") // short human-readable summary, or JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Singleton store for the live Schwab OAuth refresh token.
//
// Exists because the token CANNOT live in an env var alone for two reasons:
// (1) Schwab's refresh token expires 7 days after issuance and there is no
// programmatic renewal, so the admin panel needs somewhere to write a
// newly-exchanged token without a Vercel dashboard visit + redeploy;
// (2) "token age / days until expiry" — required by the admin system-status
// panel — is not derivable from an env var, which carries no issue date.
//
// lib/schwab.ts reads this table first and falls back to the
// SCHWAB_REFRESH_TOKEN env var when the table is empty, so nothing breaks
// before the first admin re-auth writes a row.
model SchwabToken {
  id           String   @id @default(cuid())
  singleton    String   @unique @default("main")
  refreshToken String
  obtainedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model AlertPreferences {
  id                  String   @id @default(cuid())
  clerkId             String   @unique
  newSignalAlert      Boolean  @default(true)
  highConfidenceAlert Boolean  @default(true)
  confidenceThreshold Int      @default(75)
  dailyDigest         Boolean  @default(false)
  earningsWarning     Boolean  @default(true)
  emailAlerts         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GeneratedContent {
  id           String    @id @default(cuid())
  weekOf       String
  type         String
  subtype      String    @default("")
  day          Int       @default(0)
  content      String    @db.Text
  metadata     String    @default("{}")
  contextNote  String    @default("")
  scheduledFor DateTime?
  generatedAt  DateTime  @default(now())
  usedAt       DateTime?
  performance  String?
}

model VideoRender {
  id          String    @id @default(cuid())
  templateId  String
  renderId    String    @unique
  bucketName  String
  awsRegion   String    @default("us-east-1")
  status      String    @default("rendering") // rendering | done | failed
  progress    Float     @default(0)
  outputUrl   String?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  deviceInfo   String   @default("")
  ipAddress    String   @default("")
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([lastActiveAt])
}

model HealthCheck {
  id        String   @id @default(cuid())
  status    String // "pass" | "warn" | "fail"
  results   String   @db.Text // JSON array of individual check results
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WebhookLog {
  id         String   @id @default(cuid())
  source     String   @default("stripe")
  eventType  String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// Persisted premarket/after-hours mover data — captured by
// cron/movers-snapshot every 5 min while its session is active. Needed
// because Schwab's quote API only exposes ONE `extended` snapshot per
// ticker at any moment (whichever extended session most recently had
// activity) — the other session's last-completed data would already be
// overwritten by the time a user looks at it without this persistence.
// Deliberately NOT filtered through lib/liquidityFloor.ts or
// TickerUniverse's market-cap bands — this is the unfiltered movers view,
// signal generation's liquidity floor is untouched by this model.
model MoverSnapshot {
  id                String   @id @default(cuid())
  session           String // 'premarket' | 'afterhours'
  ticker            String
  companyName       String?
  // Despite the field name, this is the REFERENCE PRICE the change is
  // measured against, not always literally "close": prior regular
  // session's close for premarket, but today's regular-session close for
  // after-hours (see cron/movers-snapshot for why). Kept the original
  // field name to avoid a destructive `prisma db push --accept-data-loss`
  // column rename on a table with live rows.
  regularClosePrice Float
  extendedLastPrice Float
  pctChange         Float
  dollarChange      Float
  capturedAt        DateTime @updatedAt

  @@unique([session, ticker])
  @@index([session])
}

// Server-side live-price cache. cron/live-quotes is the ONLY place that
// calls Schwab for this feature — every user-facing surface (dashboard
// rows, options cards, movers section) reads this table via the read-only
// /api/live/quotes route instead, so N concurrent viewers never multiply
// Schwab calls. session mirrors lib/marketSession.ts's MarketSession type.
model LiveQuoteCache {
  id               String   @id @default(cuid())
  ticker           String   @unique
  price            Float
  dayChange        Float
  dayChangePercent Float
  volume           Float
  session          String // 'regular' | 'premarket' | 'afterhours' | 'closed'
  lastUpdated      DateTime @updatedAt
}

// Weekly-screened ticker pool (Universe Expansion) — replaces the old
// hardcoded LARGE_CAP_WATCHLIST/SMALL_CAP_WATCHLIST arrays in
// cron/signals/route.ts as the daily generator's candidate source. Screened
// from NASDAQ's public market-cap+sector filterable listing, then verified
// against Schwab's live liquidity floor (Task 4 thresholds) before storage.
model TickerUniverse {
  id              String   @id @default(cuid())
  ticker          String   @unique
  marketCapBand   String // "large" | "small_mid"
  sector          String
  avgDollarVolume Float
  lastScreenedAt  DateTime @default(now())

  @@index([marketCapBand])
}

model TrialRecord {
  id                String   @id @default(cuid())
  email             String
  userId            String
  deviceFingerprint String   @default("")
  ipAddress         String   @default("")
  trialStartedAt    DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([email])
  @@index([deviceFingerprint])
  @@index([userId])
}

// DST-safe idempotency claim for the 4 extended-hours scheduled-signals slots
// (premarket-0700/0900, afterhours-1645/1830). Those crons now run every
// minute across a UTC window wide enough to cover BOTH the EDT and EST clock
// time for the slot's real ET target — the code decides whether to actually
// execute based on real America/New_York wall-clock time (see
// lib/scheduledSignals.ts#runExtendedSlotDstSafe), not a fixed UTC offset, so
// the DST transition twice a year never silently shifts the schedule again.
// Multiple invocations can legitimately land inside that window on the same
// day; this table's unique constraint ensures only the FIRST one actually
// runs the slot, the rest see the claim already exists and no-op.
model ScheduledSlotRun {
  id     String   @id @default(cuid())
  slotId String
  etDate String // 'YYYY-MM-DD' in America/New_York — the day this slot ran
  ranAt  DateTime @default(now())

  @@unique([slotId, etDate])
}

// ── News Catalyst Alerts ─────────────────────────────────────────────────────
//
// Standalone, explicitly high-risk "after the fact" alert feature — completely
// separate from the vetted Signal system. NEVER queried alongside Signal, never
// blended into the public track-record/outcomes stats. See
// app/api/cron/news-catalyst/route.ts and lib/newsCatalyst.ts for the full
// feature doc and the GlobeNewswire ToS/licensing note this was built under.

// Raw ingestion log — every RSS item fetched, regardless of whether it becomes
// an alert. Exists purely for dedup (guid is unique) so the same release isn't
// re-processed across polls; not shown in any UI.
model NewsCatalystRawItem {
  id           String   @id @default(cuid())
  guid         String   @unique
  headline     String
  body         String
  feedCategory String // the GlobeNewswire RSS topic this came from, e.g. "Contracts"
  publishedAt  DateTime
  sourceUrl    String
  fetchedAt    DateTime @default(now())

  @@index([fetchedAt])
}

// A raw item becomes a row here only after clearing ALL THREE gates: catalyst
// category match, ticker resolution (high or low confidence — never a guess
// with no match at all), and volume confirmation. See lib/newsCatalyst.ts.
model NewsCatalystAlert {
  id                        String    @id @default(cuid())
  ticker                    String
  tickerConfidence          String // 'high' | 'low' — see lib/newsCatalyst.ts#resolveTicker
  headline                  String
  sourceUrl                 String
  category                  String // 'contract_award' | 'ma' | 'fda' | 'going_concern' | 'reverse_split' | 'delisting' | 'earnings_surprise'
  publishedAt               DateTime
  detectedAt                DateTime  @default(now())
  relativeVolumeAtDetection Float
  currentPrice              Float
  priceChangePercent        Float
  // Not in the originally-specified field list — added because Step 6 (UI)
  // requires showing halt status prominently when known.
  isHalted                  Boolean   @default(false)

  // Outcome tracking (internal reference only — never published as a
  // performance claim, never blended with Signal outcomes). Populated by
  // cron/news-catalyst-outcomes on its own schedule, independently per row
  // once each interval has actually elapsed since detectedAt.
  priceChangeAt15m          Float?
  checkedAt15m              DateTime?
  priceChangeAt1h           Float?
  checkedAt1h               DateTime?
  priceChangeAtEod          Float?
  checkedAtEod              DateTime?

  @@index([detectedAt])
  @@index([ticker])
}
